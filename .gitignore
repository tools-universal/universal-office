node_modules/
dist/
*.tsbuildinfo

# Bundles browser gerados pelo check:universal / browser-smoke
tools/dist-universal/

# Specs de desenvolvimento — não versionadas
.specs/

# .NET
dotnet/**/bin/
dotnet/**/obj/

# Lab — artefatos binários intermediários (XML extraídos e diffs SÃO versionados)
**/tools/word-lab/results/**/*.docx
**/tools/excel-lab/results/**/*.xlsx
**/tools/ppt-lab/results/**/*.pptx
**/tools/ppt-lab/results/**/*.png
**/tools/excel-lab/results/pixel/**
# Lab de playback (slides) — vídeos, fontes copiadas e intermediários (run-playback.mjs regera)
**/tools/ppt-lab/results/playback/**/*.mp4
**/tools/ppt-lab/results/playback/**/*.mkv
**/tools/ppt-lab/results/playback/_assets/
**/tools/ppt-lab/results/playback/_probe/
**/tools/ppt-lab/playback/.fonts/
**/tools/ppt-lab/playback/harness.bundle.js
**/tools/ppt-lab/playback/.ppt-convert.bundle.mjs
**/tools/ppt-lab/.regress/
# Página de teste do viewer — lista de amostras gerada pelo build (decks locais)
slides/packages/viewer/demo/samples.json

# Office lock files
~$*

# Editor/IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
# Fontes PROPRIETÁRIAS (Microsoft/Monotype: Aptos, Calibri, Arial, Segoe…) NUNCA
# entram no repositório — a licença ("Microsoft supplied font") só permite usá-las
# no produto em que vieram. Ficam só na máquina: `npm run fonts:sync` as copia das
# fontes instaladas. O hook de pre-commit e o CI (tools/fonts/check-fonts.mjs)
# bloqueiam pelo CONTEÚDO, não só pelo nome. Ver CLAUDE.md.
**/aptos*.ttf
**/aptos*.otf
**/calibri*.ttf
**/arial*.ttf
**/segoe*.ttf
**/*.odttf
slides/packages/slides/demo/fonts/os/*
!slides/packages/slides/demo/fonts/os/amatic-sc-*.ttf
sheet/tools/excel-lab/fonts/
# Substitutas ABERTAS (Carlito, Caladea, Liberation Serif/Mono): a fonte única é
# shared/fonts/files; `npm run fonts:sync` copia para as bases dos demos e do site
**/demo/fonts/carlito-*.ttf
**/demo/fonts/caladea-*.ttf
**/demo/fonts/liberationserif-*.ttf
**/demo/fonts/liberationmono-*.ttf
**/demo/fonts/LICENSE-carlito.txt
**/demo/fonts/LICENSE-caladea.txt
**/demo/fonts/LICENSE-liberation.txt
site/assets/fonts/carlito-*.ttf
site/assets/fonts/caladea-*.ttf
site/assets/fonts/liberationserif-*.ttf
site/assets/fonts/liberationmono-*.ttf
site/assets/fonts/LICENSE-carlito.txt
site/assets/fonts/LICENSE-caladea.txt

# Build de publicação dos produtos (tools/build-pkg.mjs) — publicar de dentro dela
**/packages/*/publish/
