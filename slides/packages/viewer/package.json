{
  "name": "@universal-office/slides-viewer",
  "version": "0.9.2",
  "type": "module",
  "description": "Webcomponent <universal-slides-viewer> — visualizacao pura de .pptx (sem edicao)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "node demo/build.mjs",
    "test": "vitest run --passWithNoTests",
    "build:pkg": "node ../../../tools/build-pkg.mjs slides-viewer"
  },
  "dependencies": {
    "@universal-office/slides-core": "*",
    "@universal-office/fonts": "file:../../../shared/fonts",
    "@universal-office/ui": "file:../../../shared/ui"
  },
  "publish": {
    "description": "Universal Office — the <universal-slides-viewer> web component: a .pptx player faithful to PowerPoint (animations, transitions, slide show).",
    "keywords": [
      "pptx",
      "ppt",
      "powerpoint",
      "presentation",
      "viewer",
      "web-component",
      "custom-element",
      "canvas",
      "universal-office"
    ],
    "license": "MIT"
  }
}
