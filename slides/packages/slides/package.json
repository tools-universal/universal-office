{
  "name": "@universal-office-pro/slides",
  "version": "0.0.1",
  "type": "module",
  "description": "Webcomponent <universal-slides> com renderizacao de slides em canvas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "esbuild demo/main.ts --bundle --format=esm --outfile=demo/bundle.js --alias:@universal-office/slides-core=../slides-core/src/index.ts --alias:@universal-office/presentation-viewer=../viewer/src/index.ts --alias:@universal-office/fonts=../../../shared/fonts/src/index.ts --alias:@universal-office/charts=../../../shared/charts/src/index.ts --alias:@universal-office/ui=../../../shared/ui/src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@universal-office/presentation-viewer": "*",
    "@universal-office/slides-core": "*",
    "@universal-office/fonts": "file:../../../shared/fonts",
    "@universal-office/ui": "file:../../../shared/ui"
  }
}
