<Project>
  <!-- Convenções comuns da solução UniversalOffice (spec 07): net8.0 LTS, C# 12,
       nullable habilitado, sem dependências NuGet externas nos projetos src/. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Pacotes NuGet: só os projetos de src/ que ligam IsPackable (Core, Docx,
       Xlsx, Pptx, Converter); a versão acompanha os pacotes npm @universal-office/*. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>0.9.3</Version>
    <Authors>Eric Kono</Authors>
    <Copyright>Copyright (c) 2026 Eric Kono</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://universaloffice.org/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/erichideyuki/universal-office</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- o .nuspec leva a URL do repositório (acima), mas não o commit: sem consulta ao
         git no build, nem na versão informativa; a raiz do monorepo (SourceRoot abaixo)
         vira /_/ nos PDBs e no caminho do PDB gravado na DLL (ContinuousIntegrationBuild
         dos pacotes em Release) -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- documentação XML nos pacotes; membro público sem comentário não é erro -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <SourceRoot Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))$([System.IO.Path]::DirectorySeparatorChar)" />
  </ItemGroup>
</Project>
