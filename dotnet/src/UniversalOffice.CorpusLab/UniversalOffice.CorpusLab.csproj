<Project Sdk="Microsoft.NET.Sdk">
  <!-- Corpus lab do motor .NET (porta de write/tools/corpus-lab/run-engine.mjs):
       roda o UniversalOffice.DocxLayout (no UniversalOffice.Docx) sobre o corpus de
       documentos REAIS (fora do repositório, E:\UniversalWriteTest) e grava
       LAB_DIR/<tag>/<id>/net.pdf + info.json para o compare.py (source net). Nada do
       corpus entra no git. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniversalOffice.Docx\UniversalOffice.Docx.csproj" />
  </ItemGroup>
</Project>
