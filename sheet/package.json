{
  "name": "universal-sheet",
  "private": true,
  "version": "0.0.1",
  "description": "Planilha eletrônica — formato .xlsx (SpreadsheetML) e renderização fiel — parte do monorepo Universal Office",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "electron": "npm start --prefix apps/electron",
    "lab": "pwsh -ExecutionPolicy Bypass -File tools/excel-lab/run-experiment.ps1",
    "pixel:excel": "powershell -ExecutionPolicy Bypass -File tools/excel-lab/rasterize-pdf.ps1 -Pdf tools/excel-lab/results/page-oracle/oracle.pdf -OutDir tools/excel-lab/results/pixel/excel -Dpi 96",
    "pixel:compare": "node tools/pixel-compare.mjs tools/excel-lab/results/pixel/excel tools/excel-lab/results/pixel/ours tools/excel-lab/results/pixel/diff 48"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright": "^1.61.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "universal-office": "file:.."
  }
}
