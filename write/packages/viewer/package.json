{
  "name": "@universal-office/document-viewer",
  "version": "0.9.3",
  "type": "module",
  "description": "Webcomponent <universal-document-viewer> — visualização pura de .docx/.doc com a paginação e a pintura do motor do Write (sem edição)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "esbuild demo/main.ts --bundle --format=esm --outfile=demo/bundle.js --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/docx-layout=../docx-layout/src/index.ts --alias:@universal-office/drawingml=../../../shared/drawingml/src/index.ts --alias:@universal-office/fonts=../../../shared/fonts/src/index.ts --alias:@universal-office/ui=../../../shared/ui/src/index.ts",
    "test": "vitest run --passWithNoTests",
    "build:pkg": "node ../../../tools/build-pkg.mjs document-viewer"
  },
  "dependencies": {
    "@universal-office/docx-core": "*",
    "@universal-office/docx-layout": "*",
    "@universal-office/fonts": "file:../../../shared/fonts",
    "@universal-office/ui": "file:../../../shared/ui"
  },
  "publish": {
    "description": "Universal Office — the <universal-document-viewer> web component: a read-only .docx/.doc viewer with layout faithful to Microsoft Word.",
    "keywords": [
      "docx",
      "doc",
      "word",
      "viewer",
      "web-component",
      "custom-element",
      "canvas",
      "universal-office"
    ],
    "license": "MIT"
  }
}
