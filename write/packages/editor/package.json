{
  "name": "@universal-office/write",
  "version": "0.0.1",
  "type": "module",
  "description": "Webcomponent <universal-write> com renderização em canvas (fase 3 — ver ARCHITECTURE.md)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:pkg": "esbuild src/index.ts --bundle --format=esm --minify --outfile=dist/index.js --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/layout=../layout/src/index.ts --alias:@universal-office/pdf=../pdf/src/index.ts --alias:@universal-office/export=../export/src/index.ts --alias:@universal-office/odf=../odf/src/index.ts --alias:@universal-office/compare=../compare/src/index.ts && dts-bundle-generator --project tsconfig.pkg.json --no-check -o dist/index.d.ts src/index.ts && node scripts/make-dist-pkg.mjs",
    "build:demo": "esbuild demo/main.ts --bundle --format=esm --outfile=demo/bundle.js --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/layout=../layout/src/index.ts --alias:@universal-office/pdf=../pdf/src/index.ts --alias:@universal-office/export=../export/src/index.ts --alias:@universal-office/odf=../odf/src/index.ts --alias:@universal-office/compare=../compare/src/index.ts",
    "build:offline-demo": "esbuild demo/offline.ts --bundle --format=esm --outfile=demo/offline-bundle.js --loader:.ttf=binary --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/layout=../layout/src/index.ts --alias:@universal-office/pdf=../pdf/src/index.ts --alias:@universal-office/export=../export/src/index.ts --alias:@universal-office/odf=../odf/src/index.ts --alias:@universal-office/compare=../compare/src/index.ts",
    "build:site-live": "esbuild demo/site-live.ts --bundle --format=esm --outfile=../../../site/assets/universal-office.js --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/layout=../layout/src/index.ts --alias:@universal-office/pdf=../pdf/src/index.ts --alias:@universal-office/export=../export/src/index.ts --alias:@universal-office/odf=../odf/src/index.ts --alias:@universal-office/compare=../compare/src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@universal-material/web": "^3.9.4",
    "@universal-office/compare": "*",
    "@universal-office/docx-core": "*",
    "@universal-office/export": "*",
    "@universal-office/layout": "*",
    "@universal-office/odf": "*",
    "@universal-office/pdf": "*"
  }
}
