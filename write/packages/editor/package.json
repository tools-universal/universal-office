{
  "name": "@universal-office-pro/write",
  "version": "0.0.1",
  "type": "module",
  "description": "Webcomponent <universal-write> com renderização em canvas (fase 3 — ver ARCHITECTURE.md)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:pkg": "node ../../../tools/build-pkg.mjs write",
    "build:demo": "node -e \"require('fs').rmSync('demo/chunks',{recursive:true,force:true})\" && esbuild demo/main.ts --bundle --format=esm --splitting --outdir=demo --entry-names=bundle --chunk-names=chunks/[name]-[hash] --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/docx-layout=../docx-layout/src/index.ts --alias:@universal-office/drawingml=../../../shared/drawingml/src/index.ts --alias:@universal-office/fonts=../../../shared/fonts/src/index.ts --alias:@universal-office/ui=../../../shared/ui/src/index.ts --alias:@universal-office/collation=../../../sheet/packages/calc/src/collation.ts --alias:@universal-office/compare=../compare/src/index.ts --alias:@universal-office/spell=../../../shared/spell/src/index.ts && npm run build:demo-sheet",
    "build:demo-sheet": "esbuild ../../../sheet/packages/sheet/src/index.ts --bundle --format=esm --outfile=demo/sheet-bundle.js --alias:@universal-office/sheet-core=../../../sheet/packages/sheet-core/src/index.ts --alias:@universal-office/sheet-calc=../../../sheet/packages/calc/src/index.ts --alias:@universal-office/fonts=../../../shared/fonts/src/index.ts --alias:@universal-office/ui=../../../shared/ui/src/index.ts --alias:@universal-office/charts=../../../shared/charts/src/index.ts --alias:@universal-office/drawingml=../../../shared/drawingml/src/index.ts --alias:@universal-office/slides-core=../../../slides/packages/slides-core/src/index.ts",
    "build:offline-demo": "esbuild demo/offline.ts --bundle --format=esm --outfile=demo/offline-bundle.js --loader:.ttf=binary --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/docx-layout=../docx-layout/src/index.ts --alias:@universal-office/drawingml=../../../shared/drawingml/src/index.ts --alias:@universal-office/fonts=../../../shared/fonts/src/index.ts --alias:@universal-office/ui=../../../shared/ui/src/index.ts --alias:@universal-office/collation=../../../sheet/packages/calc/src/collation.ts --alias:@universal-office/compare=../compare/src/index.ts --external:@universal-office/spell",
    "build:site-live": "esbuild demo/site-live.ts --bundle --format=esm --outfile=../../../site/assets/universal-office.js --alias:@universal-office/docx-core=../docx-core/src/index.ts --alias:@universal-office/docx-layout=../docx-layout/src/index.ts --alias:@universal-office/drawingml=../../../shared/drawingml/src/index.ts --alias:@universal-office/fonts=../../../shared/fonts/src/index.ts --alias:@universal-office/ui=../../../shared/ui/src/index.ts --alias:@universal-office/collation=../../../sheet/packages/calc/src/collation.ts --alias:@universal-office/compare=../compare/src/index.ts --external:@universal-office/spell",
    "test": "vitest run"
  },
  "dependencies": {
    "@universal-material/web": "^3.9.4",
    "@universal-office/compare": "*",
    "@universal-office/docx-core": "*",
    "@universal-office/docx-layout": "*",
    "@universal-office/fonts": "file:../../../shared/fonts",
    "@universal-office/drawingml": "file:../../../shared/drawingml",
    "@universal-office/ui": "file:../../../shared/ui",
    "@universal-office/spell": "file:../../../shared/spell"
  },
  "publish": {
    "description": "Universal Write — the <universal-write> web component: a .docx editor with canvas rendering faithful to Microsoft Word.",
    "keywords": [
      "docx",
      "word",
      "ooxml",
      "editor",
      "web-component",
      "custom-element",
      "canvas",
      "universal-office"
    ],
    "license": "paid"
  }
}
