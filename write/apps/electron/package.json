{
  "name": "@universal-office/write-app-electron",
  "version": "0.9.1",
  "private": true,
  "productName": "Universal Write",
  "displayName": "Universal Write (Beta)",
  "releaseChannel": "beta",
  "description": "Editor de documentos do Word (.docx, .doc, .odt) com renderização fiel — app desktop do Universal Office",
  "license": "MIT",
  "author": "tools-universal",
  "homepage": "https://github.com/tools-universal/universal-office-desktop",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:icon": "node build/gen-icon.mjs",
    "build:license": "node -e \"require('fs').copyFileSync('../../../LICENSE','build/mit-license.txt')\"",
    "predist": "npm run build:icon && npm run build:license",
    "dist": "electron-builder --publish never",
    "dist:linux-stores": "electron-builder --publish never --linux snap",
    "smoke": "node build/smoke.mjs",
    "smoke:packaged": "node build/smoke-packaged.mjs"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.tools-universal.universal-write",
    "productName": "Universal Write",
    "electronVersion": "42.5.2",
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Eric Kono",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/editor/demo",
        "to": "packages/editor/demo",
        "filter": [
          "index.html", "bundle.js", "sheet-bundle.js", "chunks/*.js",
          "fonts/liberationsans-*.ttf", "fonts/poppins-*.woff2", "fonts/material-symbols-*.woff2", "fonts/LICENSE-*"
        ]
      },
      {
        "from": "../../../shared/fonts/files",
        "to": "packages/editor/demo/fonts",
        "filter": ["*.ttf", "LICENSE-*"]
      },
      {
        "from": "../../../shared/fonts/node/system-fonts.cjs",
        "to": "system-fonts.cjs"
      },
      {
        "from": "../../../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "UniversalWrite.docx",
        "description": "Documento do Word",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor",
        "rank": "Default",
        "icon": "file-docx"
      },
      {
        "ext": "doc",
        "name": "UniversalWrite.doc",
        "description": "Documento do Word 97-2003",
        "mimeType": "application/msword",
        "role": "Editor",
        "rank": "Alternate",
        "icon": "file-doc"
      },
      {
        "ext": "odt",
        "name": "UniversalWrite.odt",
        "description": "Texto OpenDocument",
        "mimeType": "application/vnd.oasis.opendocument.text",
        "role": "Editor",
        "rank": "Alternate",
        "icon": "file-odt"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Universal-Write-${version}-beta-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "license": "build/mit-license.txt",
      "shortcutName": "Universal Write (Beta)",
      "uninstallDisplayName": "Universal Write (Beta) ${version}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.productivity",
      "artifactName": "Universal-Write-${version}-beta-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "Universal Write (Beta)"
      }
    },
    "dmg": {
      "title": "Universal Write (Beta) ${version}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] },
        { "target": "rpm", "arch": ["x64", "arm64"] },
        { "target": "tar.gz", "arch": ["x64", "arm64"] }
      ],
      "executableName": "universal-write",
      "category": "Office",
      "synopsis": "Editor de documentos do Word com renderização fiel",
      "maintainer": "tools-universal <https://github.com/tools-universal/universal-office-desktop>",
      "vendor": "tools-universal",
      "artifactName": "Universal-Write-${version}-beta-${arch}.${ext}",
      "desktop": {
        "Name": "Universal Write (Beta)",
        "GenericName": "Word Processor",
        "Comment": "Editor de documentos do Word (.docx, .doc, .odt)",
        "Keywords": "docx;doc;odt;word;documento;texto;"
      },
      "extraFiles": [
        { "from": "flatpak", "to": "share/flatpak", "filter": ["*.desktop", "*.metainfo.xml"] },
        { "from": "build/icon-512.png", "to": "share/flatpak/icon-512.png" }
      ]
    },
    "deb": {
      "packageName": "universal-write"
    },
    "rpm": {
      "packageName": "universal-write"
    },
    "snap": {
      "title": "Universal Write (Beta)",
      "confinement": "strict",
      "grade": "stable",
      "summary": "Editor de documentos do Word com renderização fiel",
      "artifactName": "universal-write_${version}_${arch}.${ext}"
    }
  }
}
