{
  "name": "@universal-office/write-app-electron",
  "version": "0.0.1",
  "private": true,
  "description": "Shell Electron embarcando o <universal-write> (fase 5 — ver ARCHITECTURE.md)",
  "author": "tools-universal",
  "homepage": "https://github.com/tools-universal/universal-office-desktop",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:icon": "node build/gen-icon.mjs",
    "dist": "electron-builder --publish never",
    "smoke": "node build/smoke.mjs"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.tools-universal.universal-write",
    "productName": "Universal Write",
    "copyright": "Copyright © 2026 tools-universal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../../packages/editor/demo",
        "to": "packages/editor/demo",
        "filter": [
          "index.html", "bundle.js",
          "fonts/liberationsans-*.ttf", "fonts/poppins-*.woff2", "fonts/material-symbols-*.woff2", "fonts/LICENSE-*"
        ]
      },
      {
        "from": "../../../shared/fonts/node/system-fonts.cjs",
        "to": "system-fonts.cjs"
      }
    ],
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "UniversalWrite.docx",
        "description": "Documento do Word",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor",
        "rank": "Default",
        "icon": "file-docx"
      },
      {
        "ext": "doc",
        "name": "UniversalWrite.doc",
        "description": "Documento do Word 97-2003",
        "mimeType": "application/msword",
        "role": "Editor",
        "rank": "Alternate",
        "icon": "file-doc"
      },
      {
        "ext": "odt",
        "name": "UniversalWrite.odt",
        "description": "Texto OpenDocument",
        "mimeType": "application/vnd.oasis.opendocument.text",
        "role": "Editor",
        "rank": "Alternate",
        "icon": "file-odt"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Universal-Write-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "artifactName": "Universal-Write-${version}-${arch}.${ext}",
      "extraResources": [
        { "from": "../../../shared/fonts/files", "to": "packages/editor/demo/fonts", "filter": ["*.ttf", "LICENSE-*"] }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "artifactName": "Universal-Write-${version}-${arch}.${ext}",
      "extraResources": [
        { "from": "../../../shared/fonts/files", "to": "packages/editor/demo/fonts", "filter": ["*.ttf", "LICENSE-*"] }
      ]
    }
  }
}
