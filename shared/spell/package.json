{
  "name": "@universal-office/spell",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Revisão ortográfica ÚNICA dos apps (Write, Sheet, Slides) — Hunspell em Worker, dicionários abertos pt-BR/en-US sob demanda, dicionário do usuário",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gen": "node scripts/gen.mjs",
    "bench": "node bench/bench.mjs",
    "demo": "esbuild demo/main.ts --bundle --splitting --format=esm --target=es2022 --minify --outdir=demo/build --chunk-names=chunks/[name]-[hash]"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "esbuild": "^0.28.2",
    "hunspell-wasm": "0.3.0"
  }
}
